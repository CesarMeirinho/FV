@{
    ViewData["Title"] = "Preços";
}
<h2>Lista de Produtos</h2>
<table>
    <thead>
        <tr>
            <th>ID</th>
            <th>Nome</th>
            <th>Preço</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var produto in Model)
        {
            <tr>
                <td>@produto.Id</td>
                <td>@produto.Name</td>
                <td>R$ @produto.Price</td>
            </tr>
        }
    </tbody>
</table>
    


